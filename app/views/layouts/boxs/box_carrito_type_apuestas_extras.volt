<span>&nbsp;&nbsp;-&nbsp;&nbsp;</span><div class="text-monospace d-inline-block">{% for k in 0..(extras | length) - 1 %}<span>{% if extras[k] is iterable %}{% if extras[k][0] is iterable %}{% for extra in extras[k] %}<div class="d-inline-block border px-1 bg-white">{{ implode(',', extra) }}</div>{% endfor %}{% else %}<div class="d-inline-block border px-1 bg-white">{{ implode(',', extras[k]) }}</div>{% endif %}{% else %}<div class="d-inline-block border px-1 bg-white">{{ extras[k] }}</div>{% endif %}</span>{% endfor %}</div>