<div class="modal fade" id="continueBuyingModal" tabindex="-1" role="dialog" aria-labelledby="continueBuyingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cbModalTitle">Añadido correctamente</h5>
            </div>
            <div class="modal-body">
                ¿Desea seguir comprando o ir al carrito?
            </div>
            <div class="modal-footer">
                <button type="button" id="cbmContinueBuyingButton" onclick="javascript:location.reload()" class="btn btn_continueBuying">Seguir comprando</button>
                <button type="button" id="cbmGoToCartButton" onclick="javascript:location.href = '/carrito'" class="btn btn_goToCart">Ir al carrito</button>
            </div>
        </div>
    </div>
</div>